# Copy to packaging/.env and edit. The installers (install.sh / install.ps1)
# write this file for you; this template documents every variable by hand.
#
# NEVER commit packaging/.env: it holds passwords (it is gitignored).

# The public address members type into their browsers. Must match exactly -
# wrong scheme, host or port breaks sign-in cookies and federation.
BASE_URL=http://localhost:8080

# Port on this machine that serves the site. Must match the port in BASE_URL
# when the site is reached directly (behind a reverse proxy, see docs/packaging.md).
HTTP_PORT=8080

# Organization identity. The site name doubles as the organization name until an
# officer renames it in the console (the console then wins and this is ignored).
ORG_NAME=Social Spot

# Starting feature set: hoa, club, nonprofit, or community. Applies on first boot;
# afterwards the officer console owns the switches and this is ignored.
ORG_PROFILE=hoa

# The first administrator. The password is set once, when the account is created:
# changing it here later does NOT change the account (use the console or
# `docker compose exec app php bin/console.php user password <nick>` instead).
ADMIN_NICK=admin
ADMIN_PASS=change-me-to-something-long
ADMIN_MAIL=admin@example.com

# Database. The installer generates both passwords; by hand, replace them.
DB_NAME=socialspot
DB_USER=socialspot
DB_PASSWORD=change-me-too
DB_ROOT_PASSWORD=change-me-three

# ADVANCED: which upstream Friendica to build against. Tracks the stable branch
# like CI does; pin a tag (e.g. 2026.05) to freeze it deliberately.
# CORE_REF=stable
